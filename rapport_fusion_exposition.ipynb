    "def rapport_exposition(A, B, gamma):\n",
    "    zone = (A > 0.05) & (A < 0.95) & (B > 0.05) & (B < 0.95)\n",
    "    return np.median(B[zone] ** gamma / A[zone] ** gamma)\n",
    "\n",
    "lumiere = images[1] ** 2.2\n",
    "A_test = np.clip(lumiere, 0, 1) ** (1 / 2.2)\n",
    "B_test = np.clip(4 * lumiere, 0, 1) ** (1 / 2.2)\n",
    "print(round(rapport_exposition(A_test, B_test, 2.2), 3))"
   ]
  },
