    "def charger(nom):\n",
    "    \"\"\"\n",
    "    Charge une image à partir de son nom, en un tableau numpy de float32 normalisé entre 0 et 1.\"\"\"\n",
    "    octets = np.frombuffer(base64.b64decode(IMAGES_B64[nom]), np.uint8)\n",
    "    return cv2.imdecode(octets, cv2.IMREAD_COLOR).astype(np.float32) / 255.0\n",
    "\n",
    "def afficher(img, titre=\"\", ax=None):\n",
    "    \"\"\" Affiche une image chargée.\"\"\"\n",
    "    # Si aucun axe n'est fourni, crée une nouvelle figure et récupère l'axe courant.\n",
    "    if ax is None:\n",
    "        plt.figure(figsize=(8, 5))\n",
    "        ax = plt.gca()   \n",
    "    # Vérifie si l'image est en couleur (3 dimensions) puis l'affiche en RGB.\n",
    "    if img.ndim == 3:\n",
    "        ax.imshow(cv2.cvtColor(np.clip(img, 0, 1).astype(np.float32), cv2.COLOR_BGR2RGB))\n",
    "    # Si l'image est en niveaux de gris (2 dimensions), l'affiche avec une carte de couleurs en niveaux de gris.\n",
    "    else:\n",
    "        ax.imshow(img, cmap=\"gray\")\n",
    "    ax.set_title(titre)\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "scenes = {\n",
    "    \"Manarola\": [\"Manarola_under\", \"Manarola\", \"Manarola_over\"],\n",
    "    \"Phare\": [\"Lighthouse_under\", \"Lighthouse\", \"Lighthouse_over\"],\n",
    "    \"Cascade\": [\"Waterfall_under\", \"Waterfall\", \"Waterfall_over\"],\n",
    "}\n",
    "photos = {}\n",
    "for s in scenes:\n",
    "    photos[s] = []\n",
    "    for n in scenes[s]:\n",
    "        photos[s].append(charger(n))\n",
    "images = photos[\"Manarola\"]\n",
    "\n",
    "fig, axs = plt.subplots(3, 3, figsize=(15, 10))\n",
    "i = 0\n",
    "for s in scenes:\n",
    "    for j in range(3):\n",
    "        afficher(photos[s][j], scenes[s][j], axs[i, j])\n",
    "    i = i + 1\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
