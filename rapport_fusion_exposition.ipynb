   "source": [
    "expo_manarola = np.array([0.8 / 20**2, 2.5 / 22**2, 6.0 / 20**2], np.float32)\n",
    "\n",
    "def hdr_drago_reinhard(ims, temps):\n",
    "    ims_8 = en_8bits(ims)\n",
    "    reponse = cv2.createCalibrateDebevec().process(ims_8, temps)\n",
    "    hdr = cv2.createMergeDebevec().process(ims_8, temps, reponse)\n",
    "    drago = cv2.createTonemapDrago(2.2).process(hdr)\n",
    "    reinhard = cv2.createTonemapReinhard(2.2).process(hdr)\n",
    "    return hdr, np.nan_to_num(drago), np.nan_to_num(reinhard)\n",
    "\n",
    "hdr, drago, reinhard = hdr_drago_reinhard(images, expo_manarola)\n",
    "\n",
    "fig, axs = plt.subplots(1, 3, figsize=(18, 4.5))\n",
    "afficher(R_pyr, \"fusion d'exposition\", axs[0])\n",
    "afficher(drago, \"HDR + Drago\", axs[1])\n",
    "afficher(reinhard, \"HDR + Reinhard\", axs[2])\n",
    "plt.show()"
   ]
  },
