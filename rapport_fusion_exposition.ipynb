    "def en_8bits(ims):\n",
    "    res = []\n",
    "    for im in ims:\n",
    "        res.append(np.round(im * 255).astype(np.uint8))\n",
    "    return res\n",
    "\n",
    "for s in scenes:\n",
    "    ims = photos[s]\n",
    "    R_s = fusion_pyramide(ims, poids_normalises(ims), niveaux_max(ims[0]))\n",
    "    R_defaut = cv2.createMergeMertens().process(en_8bits(ims))\n",
    "    R_111 = cv2.createMergeMertens(1, 1, 1).process(en_8bits(ims))\n",
    "    print(s, round(np.abs(R_s - R_defaut).mean(), 4), round(np.abs(R_s - R_111).mean(), 4))"
   ]
