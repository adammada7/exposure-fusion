   "source": [
    "def fusion_pyramide(images, W, niveaux):\n",
    "    LR = None\n",
    "    for k in range(len(images)):\n",
    "        L = pyramide_laplace(images[k], niveaux)\n",
    "        Gw = pyramide_gauss(W[k].astype(np.float32), niveaux)\n",
    "        if LR is None:\n",
    "            LR = []\n",
    "            for l in L:\n",
    "                LR.append(np.zeros_like(l))\n",
    "        for l in range(niveaux):\n",
    "            LR[l] += Gw[l][:, :, None] * L[l]\n",
    "    return reconstruction(LR)\n",
    "\n",
    "def niveaux_max(img):\n",
    "    return int(np.log2(min(img.shape[:2]))) + 1\n",
    "\n",
    "n_max = niveaux_max(images[0])\n",
    "R = fusion_naive(images, W)\n",
    "R_pyr = fusion_pyramide(images, W, n_max)\n",
    "\n",
    "y, x = 210, 380\n",
    "fig, axs = plt.subplots(2, 3, figsize=(16, 7.5))\n",
    "afficher(images[1], \"exposition normale\", axs[0, 0])\n",
    "afficher(R, \"fusion naive\", axs[0, 1])\n",
    "afficher(R_pyr, \"fusion multiresolution\", axs[0, 2])\n",
    "afficher(images[1][y:y+210, x:x+330], \"exposition normale (zoom)\", axs[1, 0])\n",
    "afficher(R[y:y+210, x:x+330], \"fusion naive (zoom)\", axs[1, 1])\n",
    "afficher(R_pyr[y:y+210, x:x+330], \"fusion multiresolution (zoom)\", axs[1, 2])\n",
    "plt.show()"
   ]
  },
