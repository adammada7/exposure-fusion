   "source": [
    "def nettete(R):\n",
    "    gris = cv2.cvtColor(np.clip(R, 0, 1).astype(np.float32), cv2.COLOR_BGR2GRAY)\n",
    "    return cv2.Laplacian(gris, cv2.CV_32F).var() * 1000\n",
    "\n",
    "def contraste_global(R):\n",
    "    return np.clip(R, 0, 1).std()"
   ]
